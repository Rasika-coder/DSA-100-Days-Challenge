class Solution {
    public boolean isGoodArray(int[] nums) {
               int cG = nums[0];
        
        for (int i = 0; i < nums.length; i++) {
            cG = gcd(cG, nums[i]);
            if (cG == 1) return true; 
        }
        
        return cG == 1;
    }
    
    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
 
    }
}
